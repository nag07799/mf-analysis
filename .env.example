# Backend Database (set by Render automatically in production)
DATABASE_URL=postgresql+psycopg://mf:mf_local_dev@127.0.0.1:5433/mutual_funds

# Gemini API (optional, for fallback extraction and explanations)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Data root for downloaded portfolios
DATA_ROOT=./data

# Feature flags
ENABLE_EQUITY_ETFS=false
BROWSER_FALLBACK=true

# Optional corporate / additional intermediate CA bundle; TLS verification stays enabled.
# SSL_CERT_FILE=

# Frontend environment
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production settings (set in Render)
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
